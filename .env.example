# Proxy settings for install.sh.
# Copy this file to .env and uncomment/adjust the values you need.
# .env is ignored by git.

# A single proxy for all downloads. The scheme may be omitted:
#   192.168.1.10:8080  ->  http://192.168.1.10:8080
# PROXY=http://proxy.example.com:8080

# Standard variables. install.sh accepts both upper- and lowercase forms.
# They are used for fish/starship/atuin/zoxide/fzf/lsd downloads and package managers.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# Optional SOCKS proxy (curl and other libcurl-based tools; apt does not
# support SOCKS):
# ALL_PROXY=socks5://127.0.0.1:1080

# Hosts that bypass the proxy.
# NO_PROXY=localhost,127.0.0.1,::1,192.168.0.0/16
