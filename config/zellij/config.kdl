// Zellij config — палитра под Noctalia/Ghostty (те же 16 цветов, что в ghostty/kitty)
// Проверка синтаксиса: zellij setup --check

// Тема лежит в themes/nord-gap.kdl. Неактивные рамки в ней цвета фона,
// поэтому вокруг панелей остаются пустые поля — «зазоры» как в i3wm.
theme "nord-gap"

default_shell "fish"
default_mode "normal"
default_layout "default"

// Полные рамки вокруг каждой панели: неактивные сливаются с фоном и дают
// зазор в 1–2 клетки, активная обведена синим (border_active в i3).
pane_frames true
pane_frame_style "full"

// Мышь перехватывает zellij: клик фокусирует панель, колесо скроллит панель
// (Ctrl+s — режим скролла/поиска), рамки тянутся мышью, выделение мышью
// копирует. Нативное выделение терминала — Shift+протяжка.
// Не ставить false: zellij перестаёт эмитить DECSET, клики и колесо уходят в
// терминал, и клик-фокус, ресайз рамок и прокрутка пропадают.
mouse_mode true
// Протяжка мышью сразу кладёт текст в буфер обмена и снимает выделение
// (дефолт true — задан явно, чтобы не потерялся при будущих правках).
copy_on_select true
scroll_buffer_size 50000

// Копирование: на сервере нет ни X11/Wayland, ни xclip/wl-copy, поэтому
// внешний copy_command здесь работать не может — остаётся встроенный путь
// zellij: OSC 52 в клиентский терминал, дальше его буфер обмена (вставка —
// Ctrl+Shift+V в Ghostty/kitty, Cmd+V в iTerm). Клиентский терминал должен
// разрешать OSC 52. Если на машине появится clip-both, можно вернуть:
// copy_command "clip-both"

// Сессии: сохранять состояние и не спрашивать про подключение к существующей
session_serialization true
attach_to_session false

// Не показывать приветствие и changelog при первом старте
show_startup_tips false
show_release_notes false

// Ghostty умеет kitty keyboard protocol — пусть zellij его использует
support_kitty_keyboard_protocol true

ui {
    pane_frames {
        rounded_corners false
        hide_session_name true
    }
}
